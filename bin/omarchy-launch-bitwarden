#!/bin/bash

# omarchy:summary=Launch Bitwarden or start its installer when missing.

set -e

# Bitwarden reads the display scale itself, the way Electron apps do, and comes
# up oversized next to every other window on a scaled monitor. Same treatment
# 1Password gets for its hotkey.
if omarchy-cmd-present bitwarden-desktop; then
  # A window that still exists, on any workspace, is brought forward instead
  # of launching a second copy, the way the Signal launcher works.
  window_address=$(hyprctl clients -j | jq -r '.[] | select(.class | test("^bitwarden$"; "i")) | .address' | head -n1)

  if [[ -n $window_address ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$window_address\" })" >/dev/null 2>&1 ||
      hyprctl dispatch focuswindow "address:$window_address"
  else
    # Bitwarden keeps running after its window is closed, but cannot be asked
    # to open one again: it drops the window on close, and its single-instance
    # handoff then does nothing, so the hotkey would look dead until the
    # background process happened to exit. Restart it to get a window back.
    if pgrep -x bitwarden-app >/dev/null; then
      pkill -x bitwarden-app || true
      # The single-instance lock only releases once the old process is gone; a
      # new instance started before that hands off to the dying one and exits.
      for _ in $(seq 100); do
        pgrep -x bitwarden-app >/dev/null || break
        sleep 0.05
      done
    fi

    # Detached, not exec'd: setsid only forks for process-group leaders, so a
    # script caller (the installer, the defaults setup) would otherwise sit in
    # the app's foreground until it quits.
    setsid uwsm-app -- bitwarden-desktop --force-device-scale-factor=1 >/dev/null 2>&1 &
  fi
else
  exec omarchy-launch-floating-terminal-with-presentation omarchy-install-service-bitwarden
fi
